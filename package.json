{
  "name": "merge-deep-ts",
  "version": "1.3.0",
  "author": "Ilia Chernetskii <ichernetskii@gmail.com>",
  "license": "MIT",
  "description": "Deep fast merge JavaScript objects with circular references handling and TypeScript support",
  "keywords": [
    "merge",
    "deep",
    "deepmerge",
    "objects",
    "circular",
    "extend",
    "union",
    "clone",
    "assign",
    "copy",
    "recursive",
    "ts merge",
    "ts-merge",
    "typescript merge",
    "typescript-merge"
  ],
  "homepage": "https://github.com/ichernetskii/merge-deep-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ichernetskii/merge-deep-ts.git"
  },
  "bugs": {
    "url": "https://github.com/ichernetskii/merge-deep-ts/issues"
  },
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/mjs/index.d.ts",
        "default": "./dist/mjs/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "module": "dist/mjs/index.js",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "yarn run clean && cpy 'src/[c,m]js/*' 'dist' && tsc --project tsconfig.mjs.json && tsc --project tsconfig.cjs.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:types": "tsc --project tsconfig.test-types.json",
    "test:types-compat": "node scripts/types-compat.mjs",
    "test:smoke": "node --test test/smoke/esm.test.mjs test/smoke/cjs.test.cjs",
    "lint": "eslint .",
    "lint:package": "yarn pack --out reports/package.tgz && publint --strict reports/package.tgz && attw reports/package.tgz",
    "format": "eslint --fix .",
    "verify": "yarn run lint && yarn run typecheck && yarn run build && yarn run test && yarn run test:types && yarn run test:smoke && yarn run lint:package",
    "prepack": "yarn run build",
    "prepublish": "yarn run lint && yarn run test && yarn run test:types"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.12.0",
    "eslint-config-love": "^158.0.0",
    "expect-type": "^1.4.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jest-util": "^30.5.1",
    "publint": "^0.3.25",
    "ts-jest": "^29.4.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "dependenciesMeta": {
    "@parcel/watcher": {
      "built": false
    },
    "unrs-resolver": {
      "built": false
    }
  },
  "packageManager": "yarn@4.18.1"
}
